# =============================================================================
# RESUMEIQ ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# 1. Core Security
SESSION_SECRET=your-random-32-byte-hex-secret-here
PORT=8000

# 2. YouTube Data API v3 (Optional: live tutorial search)
YOUTUBE_API_KEY=

# 3. Google OAuth 2.0 (Optional: Google login)
GOOGLE_CLIENT_ID=

# 4. Optional AI LLM APIs
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=

# 5. Offline ML flags
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
